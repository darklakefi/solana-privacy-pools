{
  "name": "solana-privacy-pools",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy pools implementation for Solana using Groth16",
  "workspaces": [
    "client",
    "tests-package",
    "web"
  ],
  "scripts": {
    "build:circuits": "./build-circuits.sh",
    "build:program": "cargo build-sbf --release",
    "build": "./build.sh",
    "build:web": "npm run build --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "vercel:build": "npm install && npm run build:web",
    "clean": "rm -rf build target",
    "test": "npm run test --workspace=tests-package",
    "test:validator": "./test-with-validator.sh"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "postcss": "^8.4.31",
    "snarkjs": "^0.7.4",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "react": "16.14.0",
    "react-dom": "16.14.0"
  },
  "overrides": {
    "react": "16.14.0",
    "react-dom": "16.14.0"
  }
}
